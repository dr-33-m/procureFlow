DATABASE_URL=postgresql://username:password@localhost:5432/procureflow

# AI / OpenRouter
OPENROUTER_API_KEY=sk-or-your-key
# Text planning/chat model.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional: override only the menu-image reader. Must support image inputs.
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.5

# Logto authentication
LOGTO_ENDPOINT=https://your-tenant.logto.app
LOGTO_APP_ID=your-app-id
LOGTO_APP_SECRET=your-app-secret

# Session encryption (min 32 characters)
SESSION_SECRET=replace-with-a-random-32-char-string
